    {
      "parameters": {
        "jsCode": "// Why Code: WhatsApp webhooks mix customer messages and delivery statuses, and each\n// message type keeps its text in a different field. One node normalizes them all.\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const messages = v.messages || [];            // status updates (sent/read) have no messages\n  const names = {};\n  for (const c of v.contacts || []) names[c.wa_id] = (c.profile || {}).name || '';\n  for (const m of messages) {\n    const kind = m.type || 'other';\n    let text = '';\n    if (kind === 'text') text = (m.text || {}).body || '';\n    else if (kind === 'button') text = (m.button || {}).text || '';\n    else if (kind === 'interactive') {\n      const it = m.interactive || {};\n      text = ((it.button_reply || it.list_reply) || {}).title || '';\n    } else if (['image', 'document', 'video', 'sticker'].includes(kind)) {\n      text = `[${kind} received] ${((m[kind] || {}).caption) || ''}`.trim();\n    } else if (kind === 'audio') text = '[voice message received]';\n    else if (kind === 'location') text = '[location received]';\n    else text = `[${kind} received]`;\n    out.push({ json: {\n      wa_id: m.from,\n      customer_name: names[m.from] || '',\n      message_id: m.id,\n      kind,\n      text: text.slice(0, 2000),\n      phone_number_id: (v.metadata || {}).phone_number_id || '',\n      received_at: new Date().toISOString(),\n    }});\n  }\n}\nreturn out;"
      },
