      },
      "id": "7b1c0e4a-5555-4d2b-8c11-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "webhookId": "3f9d2c1e-7777-4a8b-9c22-000000000001",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "",
          "name": "WhatsApp OAuth (connect yours)"
        }
      }
